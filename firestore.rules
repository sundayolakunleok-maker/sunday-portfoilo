rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Portfolio Projects
    match /projects/{projectId} {
      allow read: if resource.data.status == 'published' || isSignedIn() || true;
      allow write: if isSignedIn() && isValidId(projectId);
    }

    // Resources (Documents, Assignments, Tasks, Lecture Notes, Code)
    match /resources/{resourceId} {
      allow read: if resource.data.status == 'published' || isSignedIn();
      allow write: if isSignedIn() && isValidId(resourceId);
    }

    // Videos (YouTube presentations & academic demos)
    match /videos/{videoId} {
      allow read: if resource.data.status == 'published' || isSignedIn();
      allow write: if isSignedIn() && isValidId(videoId);
    }

    // Inbound Contact Messages
    match /messages/{messageId} {
      function isValidMessage(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 150 &&
               data.email is string && data.email.size() > 0 && data.email.size() <= 150 &&
               data.subject is string && data.subject.size() > 0 && data.subject.size() <= 200 &&
               data.message is string && data.message.size() > 0 && data.message.size() <= 5000;
      }
      
      // Public visitors can submit contact inquiries
      allow create: if isValidId(messageId) && isValidMessage(request.resource.data);
      // Only authenticated administrator can read or manage messages
      allow read, update, delete: if isSignedIn() && isValidId(messageId);
    }

    // Global User Profile
    match /profile/{profileId} {
      allow read: if true;
      allow write: if isSignedIn() && isValidId(profileId);
    }

    // Admin Auth State & Security Credentials
    match /admin_auth/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Audit logs
    match /activity_logs/{logId} {
      allow read, write: if isSignedIn();
    }
  }
}
