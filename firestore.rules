rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Projects collection
    match /projects/{projectId} {
      allow get: if true;
      allow list: if true;
      
      function isValidProject(data) {
        return data.title is string && data.title.size() <= 200 &&
               data.typeOfWork is string && data.typeOfWork.size() <= 100 &&
               data.tools is string && data.tools.size() <= 1000 &&
               data.problem is string && data.problem.size() <= 5000 &&
               data.solution is string && data.solution.size() <= 5000;
      }

      allow create: if isSignedIn() && isValidId(projectId) && isValidProject(request.resource.data);
      allow update: if isSignedIn() && isValidId(projectId) && isValidProject(request.resource.data);
      allow delete: if isSignedIn() && isValidId(projectId);
    }

    // Profile collection
    match /profile/{profileId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
